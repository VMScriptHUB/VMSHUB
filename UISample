local Window

local function Notify(Title: string, Content: string, ImageOrDuration: any, Duration: number?)
	local duration = (typeof(ImageOrDuration) == "number" and ImageOrDuration) or Duration or 10
	local image = (typeof(ImageOrDuration) == "string" and ImageOrDuration) or "info"

	local win = Window or getgenv().Window
	if win and typeof(win.Notify) == "function" then
		win:Notify({
			Title = Title,
			Content = Content,
			Duration = duration,
			Image = image,
		})
	elseif Rayfield and typeof(Rayfield.Notify) == "function" then
		Rayfield:Notify({
			Title = Title,
			Content = Content,
			Duration = duration,
			Image = image,
		})
	else
		StarterGui:SetCore("SendNotification", {
			Title = Title,
			Text = Content,
			Duration = duration,
		})
	end
end

getgenv().Notify = Notify

local Flags = setmetatable({}, {
	__index = function(_, key)
		local win = Window or getgenv().Window
		local rawVal
		if win then
			if win.Flags and win.Flags[key] ~= nil then
				rawVal = win.Flags[key]
			elseif typeof(win.Get) == "function" then
				rawVal = win:Get(key)
			end
		end
		if rawVal == nil and Rayfield and Rayfield.Flags then
			rawVal = Rayfield.Flags[key]
		end

		if typeof(rawVal) == "table" and rawVal.CurrentValue ~= nil then
			return rawVal
		end

		local current = rawVal
		if current == nil then current = false end

		return {
			CurrentValue = current,
			CurrentOption = typeof(current) == "table" and current or {tostring(current)},
			Value = current,
			Set = function(_, newVal)
				local w = Window or getgenv().Window
				if w and typeof(w.Set) == "function" then
					w:Set(key, newVal)
				elseif w and w.Flags then
					w.Flags[key] = newVal
				end
			end
		}
	end,
	__newindex = function(_, key, val)
		local win = Window or getgenv().Window
		if win and win.Flags then
			win.Flags[key] = val
		end
	end
})

getgenv().Flags = Flags

