	SendNotification("Error while loading Rayfield Gen2", "Try re-executing or rejoining.")
	return
end

getgenv().Rayfield = Rayfield

local Window
local Flags: {[string]: any} = {} -- replaced with Window.Flags once the window exists (raw values: Flags.AntiAFK is a boolean)

-- Gen2 icons must be Roblox asset ids (numbers), so Lucide names like "heart" are ignored.
local function Notify(Title: string, Content: string, Image: number?)
	if not Window or Window.unloaded then
		return
	end

	Window:Notify({
		title = Title,
		content = Content,
		duration = 10,
		icon = if typeof(Image) == "number" then Image else nil,
	})
end

getgenv().Notify = Notify

task.spawn(function()
	while task.wait(Random.new():NextNumber(5 * 60, 10 * 60)) do
		Notify("Enjoying this script?", "Join the discord at discord.gg/rN4FDFjhHz")
	end
end)

if ScriptVersion and ScriptVersion ~= "Universal" then
	local PlaceFileName = getgenv().PlaceFileName

	if not PlaceFileName then
		PlaceFileName = PlaceName:gsub("%b[]", "")
		PlaceFileName = PlaceFileName:gsub("[^%a]", "")
	end
	
	local BindableFunction = Instance.new("BindableFunction")

	local Response = false

	local Button1 = "✅ Yes" 
	local Button2 = "❌ No"

	local File = `https://raw.githubusercontent.com/alyssagithub/Scripts/refs/heads/main/FrostByte/Games/{PlaceFileName}.lua`

	BindableFunction.OnInvoke = function(Button: string)
		Response = true

		if Button == Button1 then
			local OriginalFlags = {}

			if Window then
				for Flag, Value in Window.Flags do
					if typeof(Value) ~= "boolean" then
						continue
					end

					OriginalFlags[Flag] = Value
					Window:Set(Flag, false)
				end
			end

			getgenv().OriginalFlags = OriginalFlags

			loadstring(game:HttpGet(File))()
		end
	end
	
	task.spawn(function()
		while task.wait(60) do
			local Fetched, Result = pcall(game.HttpGet, game, File)

			if not Fetched or not Result then
				continue
			end

			Result = Result:split('getgenv().ScriptVersion = "')[2]
			Result = Result and Result:split('"')[1]

			if not Result or Result == ScriptVersion then
				continue
			end

			SendNotification(`A new FrostByte version {Result} has been detected!`, "Would you like to load it?", math.huge, Button1, Button2, BindableFunction)

			break
		end
	end)
end

