--[[
	FrostByteUI.lua
	Rayfield-compatible wrapper over Fluent (left sidebar tabs, modern look).
	Supports: CreateWindow, CreateTab, CreateSection, CreateLabel, CreateParagraph,
	CreateButton, CreateToggle, CreateSlider, CreateInput, CreateDropdown,
	CreateKeybind, CreateColorPicker, Notify, Flags, LoadConfiguration, Destroy.
]]

local FLUENT_URL = "https://github.com/dawid-scripts/Fluent/releases/latest/download/main.lua"

local HttpService = game:GetService("HttpService")
local env = getfenv()

local isfile, readfile, writefile = env.isfile, env.readfile, env.writefile
local isfolder, makefolder = env.isfolder, env.makefolder

local ok, Fluent = pcall(function()
	return loadstring(game:HttpGet(FLUENT_URL))()
end)

if not ok or typeof(Fluent) ~= "table" then
	return nil
end

local Rayfield = {Flags = {}}
local Flags = Rayfield.Flags

local SaveEnabled, SaveFolder, SaveName = false, "FrostByte", "Config"
local Suppress = false
local SaveQueued = false
local Counter = 0
local WindowObject

local ThemeMap = {
	Default = "Dark",
	Dark = "Darker",
	Light = "Light",
	Ocean = "Aqua",
	Amethyst = "Amethyst",
	Bloom = "Rose",
	AmberGlow = "Dark",
	Green = "Aqua",
	Serenity = "Aqua",
	DarkBlue = "Dark",
}

local function SafeCall(Callback, ...)
	if typeof(Callback) ~= "function" then
		return
	end

	local Success, Err = pcall(Callback, ...)

	if not Success then
		warn("[FrostByteUI] callback error:", Err)
	end
end

local function NewFlag(Name, Entry)
	Counter += 1

	Name = Name or ("Unnamed" .. Counter)

	if Flags[Name] then
		Name = Name .. "_" .. Counter -- duplicate flag names would overwrite each other
	end

	Flags[Name] = Entry
	Entry.Name = Name

	return Name
end

-- Saving / loading --------------------------------------------------------

local function GetPath()
	return `{SaveFolder}/{SaveName}.json`
end

local function Encode(Entry)
	if Entry.Type == "Dropdown" then
		return Entry.CurrentOption
	elseif Entry.Type == "Keybind" then
		return Entry.CurrentKeybind
	elseif Entry.Type == "Color" then
		return Entry.CurrentValue:ToHex()
	end

	return Entry.CurrentValue
end

local function Save()
	SaveQueued = false

	if not SaveEnabled or not writefile then
		return
	end

	local Data = {}

	for Name, Entry in Flags do
		Data[Name] = Encode(Entry)
	end

	pcall(function()
		if makefolder and isfolder and not isfolder(SaveFolder) then
			makefolder(SaveFolder)
		end

		writefile(GetPath(), HttpService:JSONEncode(Data))
	end)
end

local function QueueSave()
	if SaveQueued or not SaveEnabled then
		return
	end

	SaveQueued = true
	task.delay(1, Save)
end

local function Read()
	if not SaveEnabled or not isfile or not readfile then
		return
	end

	local Success, Data = pcall(function()
		if not isfile(GetPath()) then
			return
		end

		return HttpService:JSONDecode(readfile(GetPath()))
	end)

	return Success and Data or nil
end

-- Notifications / lifecycle -----------------------------------------------

function Rayfield:Notify(Options)
	Fluent:Notify({
		Title = Options.Title or "Notification",
		Content = Options.Content or "",
		Duration = Options.Duration or 6,
	})
end

function Rayfield:Destroy()
	pcall(function()
		Fluent:Destroy()
	end)
end

function Rayfield:LoadConfiguration()
	local Data = Read()

	for Name, Entry in Flags do
		local Saved = Data and Data[Name]

		if Saved ~= nil then
			Suppress = true
			pcall(Entry.Set, Entry, Saved)
			Suppress = false
		end

		if Entry.Callback and Entry.Type ~= "Keybind" then
			local Value = if Entry.Type == "Dropdown" then Entry.CurrentOption else Entry.CurrentValue
			task.spawn(SafeCall, Entry.Callback, Value)
		end
	end

	if WindowObject and WindowObject._first then
		pcall(function()
			WindowObject._fluent:SelectTab(1)
		end)
	end
end

-- Window --------------------------------------------------------------------

local TabClass = {}
TabClass.__index = TabClass

function TabClass:CreateSection(Name)
	self._tab:AddSection(Name)
end

function TabClass:CreateLabel(Text)
	local Element = self._tab:AddParagraph({Title = Text, Content = ""})

	return {
		Set = function(_, NewText)
			if Element.SetTitle then
				Element:SetTitle(NewText)
			end
		end,
	}
end

function TabClass:CreateParagraph(Options)
	return self._tab:AddParagraph({
		Title = Options.Title or "",
		Content = Options.Content or "",
	})
end

function TabClass:CreateButton(Options)
	self._tab:AddButton({
		Title = Options.Name,
		Description = Options.Description,
		Callback = function()
			SafeCall(Options.Callback)
		end,
	})
end

function TabClass:CreateToggle(Options)
	local Entry = {Type = "Toggle", CurrentValue = Options.CurrentValue or false, Callback = Options.Callback}
	local Flag = NewFlag(Options.Flag, Entry)

	local Element = self._tab:AddToggle(Flag, {
		Title = Options.Name,
		Description = Options.Description,
		Default = Entry.CurrentValue,
	})

	Element:OnChanged(function(Value)
		Entry.CurrentValue = Value
		QueueSave()

		if not Suppress then
			task.spawn(SafeCall, Options.Callback, Value)
		end
	end)

	function Entry:Set(Value)
		Element:SetValue(Value)
	end

	return Entry
end

function TabClass:CreateSlider(Options)
	local Range = Options.Range or {0, 100}
	local Increment = Options.Increment or 1
	local Rounding = if Increment >= 1 then 0 else math.max(0, math.ceil(-math.log10(Increment)))

	local Entry = {Type = "Slider", CurrentValue = Options.CurrentValue or Range[1], Callback = Options.Callback}
	local Flag = NewFlag(Options.Flag, Entry)

	local Element = self._tab:AddSlider(Flag, {
		Title = Options.Name,
		Description = Options.Suffix and `Unit: {Options.Suffix}` or Options.Description,
		Default = Entry.CurrentValue,
		Min = Range[1],
		Max = Range[2],
		Rounding = Rounding,
	})

	Element:OnChanged(function(Value)
		Entry.CurrentValue = Value
		QueueSave()

		if not Suppress then
			task.spawn(SafeCall, Options.Callback, Value)
		end
	end)

	function Entry:Set(Value)
		Element:SetValue(Value)
	end

	return Entry
end

function TabClass:CreateInput(Options)
	local Entry = {Type = "Input", CurrentValue = Options.CurrentValue or "", Callback = Options.Callback}
	local Flag = NewFlag(Options.Flag, Entry)

	local Element = self._tab:AddInput(Flag, {
		Title = Options.Name,
		Description = Options.Description,
		Default = Entry.CurrentValue,
		Placeholder = Options.PlaceholderText or "",
		Numeric = false,
		Finished = false,
	})

	Element:OnChanged(function(Value)
		Entry.CurrentValue = Value
		QueueSave()

		if not Suppress then
			task.spawn(SafeCall, Options.Callback, Value)
		end
	end)

	function Entry:Set(Value)
		Element:SetValue(Value)
	end

	return Entry
end

function TabClass:CreateDropdown(Options)
	local Multi = Options.MultipleOptions or false
	local Values = Options.Options or {}

	local Initial = Options.CurrentOption
	if typeof(Initial) == "string" then
		Initial = {Initial}
	end
	Initial = Initial or {}

	local Entry = {Type = "Dropdown", CurrentOption = Initial, Callback = Options.Callback}
	local Flag = NewFlag(Options.Flag, Entry)

	local Default
	if Multi then
		Default = {}
		for _, Name in Initial do
			Default[Name] = true
		end
	else
		Default = table.find(Values, Initial[1])
	end

	local Element = self._tab:AddDropdown(Flag, {
		Title = Options.Name,
		Description = Options.Description,
		Values = Values,
		Multi = Multi,
		Default = Default,
	})

	Element:OnChanged(function(Value)
		local List = {}

		if Multi then
			for Name, Enabled in Value do
				if Enabled then
					table.insert(List, Name)
				end
			end
		elseif Value then
			List = {Value}
		end

		Entry.CurrentOption = List
		QueueSave()

		if not Suppress then
			task.spawn(SafeCall, Options.Callback, List)
		end
	end)

	function Entry:Set(NewOptions)
		if typeof(NewOptions) == "string" then
			NewOptions = {NewOptions}
		end

		if Multi then
			local Map = {}
			for _, Name in NewOptions do
				Map[Name] = true
			end
			Element:SetValue(Map)
		else
			Element:SetValue(NewOptions[1])
		end
	end

	function Entry:Refresh(NewValues)
		Element:SetValues(NewValues)
	end

	return Entry
end

function TabClass:CreateKeybind(Options)
	local Entry = {Type = "Keybind", CurrentKeybind = Options.CurrentKeybind or "E", Callback = Options.Callback}
	local Flag = NewFlag(Options.Flag, Entry)

	local Element = self._tab:AddKeybind(Flag, {
		Title = Options.Name,
		Description = Options.Description,
		Mode = Options.HoldToInteract and "Hold" or "Toggle",
		Default = Entry.CurrentKeybind,
		Callback = function(Value)
			if not Suppress then
				task.spawn(SafeCall, Options.Callback, Value)
			end
		end,
		ChangedCallback = function(New)
			Entry.CurrentKeybind = tostring(New.Name or New)
			QueueSave()
		end,
	})

	function Entry:Set(Key)
		Element:SetValue(Key, Options.HoldToInteract and "Hold" or "Toggle")
	end

	return Entry
end

function TabClass:CreateColorPicker(Options)
	local Entry = {Type = "Color", CurrentValue = Options.Color or Color3.new(1, 1, 1), Callback = Options.Callback}
	local Flag = NewFlag(Options.Flag, Entry)

	local Element = self._tab:AddColorpicker(Flag, {
		Title = Options.Name,
		Description = Options.Description,
		Default = Entry.CurrentValue,
	})

	Element:OnChanged(function(Value)
		Entry.CurrentValue = Value
		QueueSave()

		if not Suppress then
			task.spawn(SafeCall, Options.Callback, Value)
		end
	end)

	function Entry:Set(Value)
		if typeof(Value) == "string" then
			Value = Color3.fromHex(Value)
		end
		Element:SetValue(Value)
	end

	return Entry
end

-- Rayfield used CreateColorPicker / CreateColorpicker inconsistently
TabClass.CreateColorpicker = TabClass.CreateColorPicker

local WindowClass = {}
WindowClass.__index = WindowClass

function WindowClass:CreateTab(Name, Icon)
	local Tab

	local Success = pcall(function()
		Tab = self._fluent:AddTab({Title = Name, Icon = Icon or ""})
	end)

	if not Success or not Tab then
		Tab = self._fluent:AddTab({Title = Name, Icon = ""})
	end

	self._first = true

	return setmetatable({_tab = Tab}, TabClass)
end

function Rayfield:CreateWindow(Settings)
	local FullName = tostring(Settings.Name or "Hub")
	local Title, SubTitle = FullName:match("^(.-)%s*|%s*(.+)$")

	local Saving = Settings.ConfigurationSaving
	if Saving and Saving.Enabled then
		SaveEnabled = true
		SaveFolder = Saving.FolderName or SaveFolder
		SaveName = Saving.FileName or SaveName
	end

	local FluentWindow = Fluent:CreateWindow({
		Title = Title or FullName,
		SubTitle = SubTitle or Settings.LoadingSubtitle or "",
		TabWidth = 160,
		Size = UDim2.fromOffset(580, 460),
		Acrylic = false,
		Theme = ThemeMap[Settings.Theme] or "Dark",
		MinimizeKey = Enum.KeyCode.RightControl,
	})

	local Window = setmetatable({_fluent = FluentWindow}, WindowClass)

	-- Works with both Window.ModifyTheme(x) and Window:ModifyTheme(x)
	Window.ModifyTheme = function(A, B)
		local Theme = if B ~= nil then B else A

		if typeof(Theme) ~= "string" then
			return
		end

		pcall(function()
			Fluent:SetTheme(ThemeMap[Theme] or Theme)
		end)
	end

	WindowObject = Window

	return Window
end

local GetGenv = env.getgenv
if GetGenv then
	GetGenv().Rayfield = Rayfield
end

return Rayfield
