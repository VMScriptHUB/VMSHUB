--[[
	FrostByteUI_Gen2.lua
	Lets scripts written for the old Rayfield (2022) API run on Rayfield Gen2
	with the sidebar layout (tabs on the left).

	Old API in  -> Gen2 out. Your existing code keeps using:
	Window:CreateTab, Tab:CreateSection/Label/Paragraph/Button/Toggle/Slider/Input/
	Dropdown/Keybind, Rayfield:Notify, Rayfield.Flags (.CurrentValue / .CurrentOption / :Set),
	Rayfield:LoadConfiguration, Rayfield:Destroy, Window.ModifyTheme.

	Not shimmed: ColorPicker (use Gen2's tab:CreateColorPicker directly if you need it).
]]

local GEN2_URL = "https://sirius.menu/gen2"

local Success, Gen2 = pcall(function()
	return loadstring(game:HttpGet(GEN2_URL))()
end)

if not Success or typeof(Gen2) ~= "table" or not Gen2.CreateWindow then
	return nil
end

local Shim = {Flags = {}}
local Flags = Shim.Flags

local RealWindow
local Registry = {}
local Counter = 0

local ThemeMap = {
	Default = "default",
	DarkBlue = "cobalt",
	Ocean = "cobalt",
	AmberGlow = "ember",
	Amethyst = "amethyst",
	Bloom = "rose",
	Light = "frost",
	Serenity = "frost",
	Dark = "default",
	Green = "default",
}

-- Gen2 only accepts asset ids / rbx* strings as icons. Lucide names from the old API are dropped.
local function Icon(Value)
	if typeof(Value) == "number" and Value ~= 0 then
		return Value
	end

	if typeof(Value) == "string" and Value:match("^rbx") then
		return Value
	end

	return nil
end

local function SafeCall(Callback, ...)
	if typeof(Callback) ~= "function" then
		return
	end

	local Ok, Err = pcall(Callback, ...)

	if not Ok then
		warn("[FrostByteUI] callback error:", Err)
	end
end

local function UniqueFlag(Name)
	Counter += 1
	Name = Name or ("Unnamed" .. Counter)

	if Flags[Name] then
		Name = `{Name}_{Counter}`
	end

	return Name
end

-- Builds the old-style flag object: Flags.X.CurrentValue / .CurrentOption / :Set()
local function RegisterFlag(Flag, Entry)
	Registry[#Registry + 1] = Entry

	Flags[Flag] = setmetatable({}, {
		__index = function(_, Key)
			local Handle = Entry.Handle

			if Key == "CurrentValue" then
				return if Handle then Handle.value else Entry.Initial
			elseif Key == "CurrentOption" then
				return if Handle then Handle.value else Entry.Initial
			elseif Key == "CurrentKeybind" then
				local Value = Handle and Handle.value or Entry.Initial
				return if typeof(Value) == "EnumItem" then Value.Name else tostring(Value)
			elseif Key == "Set" then
				return function(_, Value)
					if Entry.Handle then
						Entry.Set(Value)
					end
				end
			elseif Key == "Refresh" then
				return function(_, Options)
					if Entry.Handle and Entry.Handle.Refresh then
						Entry.Handle:Refresh(Options)
					end
				end
			end

			return nil
		end,
	})
end

local function Wrap(Entry, Callback)
	return function(...)
		Entry.Fired = true
		task.spawn(SafeCall, Callback, ...)
	end
end

-- Tabs ----------------------------------------------------------------------

local Tab = {}
Tab.__index = Tab

function Tab:CreateSection(Name)
	self._tab:CreateSection({name = Name})
end

function Tab:CreateLabel(Text, IconValue)
	local Handle = self._tab:CreateText({name = Text, icon = Icon(IconValue)})

	return {
		Set = function(_, NewText)
			if Handle and Handle.SetTitle then
				Handle:SetTitle(NewText)
			end
		end,
	}
end

function Tab:CreateParagraph(Options)
	return self._tab:CreateText({
		name = Options.Title,
		text = Options.Content,
	})
end

function Tab:CreateDivider()
	if self._tab.CreateDivider then
		self._tab:CreateDivider()
	end
end

function Tab:CreateButton(Options)
	return self._tab:CreateButton({
		name = Options.Name,
		description = Options.Description or Options.Info,
		icon = Icon(Options.Icon),
		callback = function()
			task.spawn(SafeCall, Options.Callback)
		end,
	})
end

function Tab:CreateToggle(Options)
	local Flag = UniqueFlag(Options.Flag)
	local Entry = {Initial = Options.CurrentValue or false}

	Entry.Handle = self._tab:CreateToggle({
		name = Options.Name,
		description = Options.Description or Options.Info,
		flag = Flag,
		value = Entry.Initial,
		callback = Wrap(Entry, Options.Callback),
	})

	Entry.Set = function(Value)
		Entry.Handle:Set(Value)
	end

	Entry.Fire = function()
		Wrap(Entry, Options.Callback)(Entry.Handle.value)
	end

	RegisterFlag(Flag, Entry)

	return Flags[Flag]
end

function Tab:CreateSlider(Options)
	local Range = Options.Range or {0, 100}
	local Flag = UniqueFlag(Options.Flag)
	local Entry = {Initial = Options.CurrentValue or Range[1]}

	Entry.Handle = self._tab:CreateSlider({
		name = Options.Name,
		description = Options.Description or Options.Info,
		flag = Flag,
		range = Range,
		increment = Options.Increment or 1,
		suffix = Options.Suffix,
		value = Entry.Initial,
		callback = function(Value)
			Entry.Fired = true
			task.spawn(SafeCall, Options.Callback, Value)
		end,
	})

	Entry.Set = function(Value)
		Entry.Handle:Set(Value)
	end

	Entry.Fire = function()
		Entry.Fired = true
		task.spawn(SafeCall, Options.Callback, Entry.Handle.value)
	end

	RegisterFlag(Flag, Entry)

	return Flags[Flag]
end

function Tab:CreateInput(Options)
	local Flag = UniqueFlag(Options.Flag)
	local Entry = {Initial = Options.CurrentValue or ""}

	Entry.Handle = self._tab:CreateInput({
		name = Options.Name,
		description = Options.Description or Options.Info,
		flag = Flag,
		value = Entry.Initial,
		placeholder = Options.PlaceholderText,
		callback = Wrap(Entry, Options.Callback),
	})

	Entry.Set = function(Value)
		Entry.Handle:Set(Value)
	end

	Entry.Fire = function()
		Wrap(Entry, Options.Callback)(Entry.Handle.value)
	end

	RegisterFlag(Flag, Entry)

	return Flags[Flag]
end

function Tab:CreateDropdown(Options)
	local Multi = Options.MultipleOptions or Options.MultiSelection or false
	local Flag = UniqueFlag(Options.Flag)

	local Selected = Options.CurrentOption
	if typeof(Selected) == "string" then
		Selected = {Selected}
	end
	Selected = Selected or {}

	local Entry = {Initial = Selected}

	local function ToList(Value)
		if typeof(Value) == "table" then
			return Value
		end

		return if Value == nil then {} else {Value}
	end

	Entry.Handle = self._tab:CreateDropdown({
		name = Options.Name,
		description = Options.Description or Options.Info,
		flag = Flag,
		options = Options.Options or {},
		multiSelect = Multi,
		value = if Multi then Selected else Selected[1],
		callback = function(Value)
			Entry.Fired = true
			task.spawn(SafeCall, Options.Callback, ToList(Value)) -- old API always gave a table
		end,
	})

	Entry.Set = function(Value)
		local List = ToList(Value)
		Entry.Handle:Set(if Multi then List else List[1])
	end

	Entry.Fire = function()
		Entry.Fired = true
		task.spawn(SafeCall, Options.Callback, ToList(Entry.Handle.value))
	end

	RegisterFlag(Flag, Entry)

	return Flags[Flag]
end

function Tab:CreateKeybind(Options)
	local Flag = UniqueFlag(Options.Flag)
	local Entry = {Initial = Options.CurrentKeybind or "E"}

	Entry.Handle = self._tab:CreateKeybind({
		name = Options.Name,
		description = Options.Description or Options.Info,
		flag = Flag,
		value = Entry.Initial,
		hold = Options.HoldToInteract or false,
		callback = function(...)
			task.spawn(SafeCall, Options.Callback, ...)
		end,
	})

	Entry.Set = function(Value)
		Entry.Handle:Set(Value)
	end

	RegisterFlag(Flag, Entry) -- keybinds have no Fire: pressing is the trigger

	return Flags[Flag]
end

-- Window --------------------------------------------------------------------

local Window = {}
Window.__index = Window

function Window:CreateTab(Name, IconValue)
	local Real = RealWindow:CreateTab({name = Name, icon = Icon(IconValue)})

	return setmetatable({_tab = Real}, Tab)
end

function Shim:CreateWindow(Settings)
	local FullName = tostring(Settings.Name or "Hub")
	local Title, SubTitle = FullName:match("^(.-)%s*|%s*(.+)$")

	local Props = {
		name = Title or FullName,
		subtitle = SubTitle or Settings.LoadingSubtitle,
		theme = ThemeMap[Settings.Theme] or "default",
		sidebarLayout = true,
		showName = Title or FullName,
	}

	local Saving = Settings.ConfigurationSaving

	if Saving and Saving.Enabled then
		Props.configuration = {
			autoSave = true,
			autoLoad = false, -- LoadConfiguration() does it once every element exists
			fileName = Saving.FileName,
			customFolder = Saving.FolderName,
		}
	end

	RealWindow = Gen2:CreateWindow(Props)

	local Wrapper = setmetatable({_real = RealWindow}, Window)

	-- works as Window.ModifyTheme(x) and Window:ModifyTheme(x)
	Wrapper.ModifyTheme = function(A, B)
		local Theme = if B ~= nil then B else A

		if typeof(Theme) ~= "string" then
			return
		end

		pcall(function()
			RealWindow:ChangeTheme(ThemeMap[Theme] or Theme)
		end)
	end

	return Wrapper
end

function Shim:Notify(Options)
	if not RealWindow then
		return
	end

	pcall(function()
		RealWindow:Notify({
			title = Options.Title,
			content = Options.Content,
			icon = Icon(Options.Image),
			duration = Options.Duration,
		})
	end)
end

function Shim:LoadConfiguration()
	if RealWindow then
		pcall(function()
			RealWindow:Load()
		end)
	end

	-- the old library ran every callback once on load; do the same for any that haven't fired yet
	for _, Entry in Registry do
		if Entry.Fire and not Entry.Fired then
			Entry.Fire()
		end
	end
end

function Shim:Destroy()
	if RealWindow then
		pcall(function()
			RealWindow:Unload()
		end)

		RealWindow = nil
	end
end

local GetGenv = getfenv().getgenv

if GetGenv then
	GetGenv().Rayfield = Shim
end

return Shim
